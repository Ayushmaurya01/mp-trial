# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/student_tracker or MongoDB Atlas URI)
# If left as mongodb://localhost:27017/student_tracker and local mongod is not available, server automatically uses in-memory database for hassle-free demonstration.
MONGODB_URI=mongodb://localhost:27017/student_tracker

# JWT Authentication Secret Key
JWT_SECRET=super_secret_student_tracker_jwt_key_2026_academic_demo
JWT_EXPIRE=30d
